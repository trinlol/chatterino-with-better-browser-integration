{
  "name": "chatterino-better-browser",
  "version": "2.6.2",
  "description": "Chatterino desktop client with native Twitch browser integration.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:extension",
    "test:extension": "node scripts/validate-extension.mjs && node scripts/validate-release-contract.mjs",
    "test:e2e:contract": "node --test chatterino-extension/tests/e2e/*.test.mjs",
    "test:fixture:prediction-bet": "node scripts/prediction-bet-popup-fixture.mjs",
    "test:browser-native": "npm run test:extension && npm run test:e2e:contract",
    "smoke:browser-native:windows": "powershell -ExecutionPolicy Bypass -File scripts/browser-integration/run-windows-smoke.ps1",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trinlol/chatterino-with-better-browser-integration.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/trinlol/chatterino-with-better-browser-integration/issues"
  },
  "homepage": "https://github.com/trinlol/chatterino-with-better-browser-integration#readme"
}
