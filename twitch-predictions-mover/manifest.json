{
  "manifest_version": 3,
  "name": "Twitch Predictions Mover",
  "version": "1.0",
  "description": "Moves Twitch prediction and poll banners to a floating, draggable window so they are not blocked by Chatterino.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "nativeMessaging"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
