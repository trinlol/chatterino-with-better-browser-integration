{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "Chatterino Better Browser",
  "version": "2.6.2",
  "description": "Replaces Twitch chat with Chatterino Better Browser and syncs polls, predictions, pinned messages, and channel points.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "icons": {
    "256": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatterino_native@chatterino.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["notification-ui.js", "anti-wipe.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["overlay.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["protocol.js", "activity-state.js", "voting-ui.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-inject.js", "twitch-api.js"],
      "matches": ["https://*.twitch.tv/*"]
    }
  ]
}
